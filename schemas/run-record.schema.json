{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/draiagent/VAD-Benchmark/schemas/run-record.schema.json",
  "title": "VAD Benchmark Run Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "study_id", "run_id", "benchmark_version", "condition", "task_type",
    "model", "provenance", "tool_access", "input_hash", "timing",
    "acceptance", "errors", "interaction", "final_status"
  ],
  "properties": {
    "study_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "benchmark_version": {"type": "string"},
    "condition": {"enum": ["A", "B", "C", "D", "E", "F", "P0", "P1", "P2"]},
    "task_type": {"enum": ["video", "slides", "web", "data", "report"]},
    "model": {
      "type": "object",
      "required": ["provider", "name", "version"],
      "properties": {
        "provider": {"type": "string"},
        "name": {"type": "string"},
        "version": {"type": "string"},
        "platform": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["vad_core_ref", "promptless_ref"],
      "properties": {
        "vad_core_ref": {"type": "string"},
        "promptless_ref": {"type": "string"}
      }
    },
    "tool_access": {"type": "array", "items": {"type": "string"}},
    "input_hash": {"type": "string", "minLength": 8},
    "timing": {
      "type": "object",
      "required": ["human_active_seconds", "agent_wait_seconds", "wall_clock_seconds"],
      "properties": {
        "human_active_seconds": {"type": "number", "minimum": 0},
        "agent_wait_seconds": {"type": "number", "minimum": 0},
        "wall_clock_seconds": {"type": "number", "minimum": 0}
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["passed", "total", "first_pass"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "first_pass": {"type": "boolean"}
      }
    },
    "errors": {
      "type": "object",
      "required": ["critical", "major", "minor"],
      "properties": {
        "critical": {"type": "integer", "minimum": 0},
        "major": {"type": "integer", "minimum": 0},
        "minor": {"type": "integer", "minimum": 0}
      }
    },
    "interaction": {
      "type": "object",
      "required": ["revision_count", "prompt_chars", "prompt_turns", "clarification_turns"],
      "properties": {
        "revision_count": {"type": "integer", "minimum": 0},
        "prompt_chars": {"type": "integer", "minimum": 0},
        "prompt_turns": {"type": "integer", "minimum": 0},
        "clarification_turns": {"type": "integer", "minimum": 0}
      }
    },
    "ratings": {"type": "object"},
    "final_status": {"enum": ["passed", "failed", "incomplete", "invalid", "capability_mismatch"]}
  }
}
